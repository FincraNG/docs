            "openapi": {
              "source": "api/specs/disbursements.yaml",
              "directory": "api"
            },
            "pages": [
              {
                "group": "Beneficiaries",
                "openapi": {
                  "source": "api/specs/beneficiaries.yaml",
                  "directory": "api/payouts"
                },
                "pages": [
                  "GET /profile/beneficiaries/business/{businessID}",
                  "POST /profile/beneficiaries/business/{businessID}",
                  "GET /profile/beneficiaries/business/{businessID}/{beneficiaryID}",
                  "PATCH /profile/beneficiaries/business/{businessID}/{beneficiaryID}",
                  "DELETE /profile/beneficiaries/business/{businessID}/{beneficiaryID}"
