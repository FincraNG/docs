            },
            "pages": [
              "GET /profile/business/me",
              "GET /profile/merchants/me",
              "PATCH /profile/business/{businessID}/settings",
              "GET /profile/business"
            ]
          },
          {
            "group": "Verification",
            "openapi": {
              "source": "api/specs/verification.yaml",
              "directory": "api"
