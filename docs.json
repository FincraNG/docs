            "openapi": {
              "source": "api/specs/sandbox.yaml",
              "directory": "api"
            },
            "pages": [
              "POST /wallets/fund",
              "POST /collections/transfer/simulate",
              "POST /checkout-core/webhooks/charges/bank-transfer"
