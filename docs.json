{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Fincra",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "logo": {
    "light": "/logo/finc.svg",
    "dark": "/logo/finc-dark.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "pages": [
          "index",
          {
            "group": "Quickstart",
            "pages": [
              "quickstart/create-a-sandbox-account",
              "quickstart/send-your-first-api-request"
            ]
          },
          {
            "group": "Products",
            "pages": [
              "payments/overview",
              {
                "group": "Payouts",
                "pages": [
                  "payouts/overview",
                  "payouts/requirements"
                ]
              },
              "virtual-accounts/overview",
              "fx-and-conversion/overview",
              "wallets-and-balances/overview",
              "direct-debit/overview",
              "issuing/overview",
              "verification/overview"
            ]
          },
          "developer-tools/overview",
          "api-reference",
          "changelog",
          "support",
          "glossary"
        ]
      },
      {
        "tab": "API Reference",
        "pages": [
          "api/introduction",
          "api/authentication",
          "api/errors",
          "api/data-types",
          "api/pagination",
          "api/idempotency",
          "api/rate-limits",
          "api/webhooks",
          "api/versioning",
          {
            "group": "Business",
            "openapi": {
              "source": "api/specs/profile.yaml",
              "directory": "api"
            },
            "pages": [
              "GET /profile/business/me",
              "GET /profile/merchants/me",
              "PATCH /profile/business/{businessID}/settings",
              "GET /profile/business"
            ]
          },
          {
            "group": "Payouts",
            "openapi": {
              "source": "api/specs/disbursements.yaml",
              "directory": "api"
            },
            "pages": [
              "POST /disbursements/payouts",
              "GET /disbursements/payouts/reference/{reference}",
              "GET /disbursements/payouts/customer-reference/{customerReference}",
              "GET /disbursements/payouts",
              "POST /disbursements/payouts/wallets",
              "POST /disbursements/payouts/documents-upload"
            ]
          },
          {
            "group": "Quotes",
            "openapi": {
              "source": "api/specs/quotes.yaml",
              "directory": "api"
            },
            "pages": [
              "POST /quotes/generate"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "API Reference",
        "href": "/api/introduction"
      },
      {
        "label": "Documentation",
        "href": "/"
      },
      {
        "label": "Log in",
        "href": "https://app.fincra.com/auth/login"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started in sandbox",
      "href": "https://app.fincra.com/auth/signup"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "api": {
    "examples": {
      "languages": [
        "bash",
        "node"
      ],
      "defaults": "required"
    }
  }
}
