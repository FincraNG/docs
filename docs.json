            "openapi": {
              "source": "api/specs/quotes.yaml",
              "directory": "api"
            },
            "pages": [
              "POST /quotes/generate"
            ]
          },
          {
            "group": "Conversions",
            "openapi": {
              "source": "api/specs/conversions.yaml",
              "directory": "api"
            },
            "pages": [
              "POST /conversions/initiate",
              "GET /conversions/{id}",
              "GET /conversions/reference/{reference}",
              "GET /conversions/customer-reference/{customerReference}",
              "GET /conversions"
