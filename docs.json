            "group": "Reference data",
            "openapi": {
              "source": "api/specs/reference-data.yaml",
              "directory": "api"
            },
            "pages": [
              "GET /core/banks"
            ]
          },
          {
            "group": "Direct Debit",
            "pages": [
              "api/direct-debit/overview"
            ]
          },
          {
            "group": "Issuing",
            "pages": [
              "api/issuing/overview"
            ]
          }
        ]
      },
      {
        "tab": "Virtual Accounts",
        "pages": [
          "virtual-accounts/overview",
          "virtual-accounts/supported-countries-and-currencies"
        ]
      },
      {
        "tab": "Developer tools",
        "pages": [
          {
            "group": "Developer tools",
            "pages": [
              "developer-tools/overview"
            ]
          },
          {
            "group": "Test",
            "pages": [
              "developer-tools/sandbox"
            ]
          }
        ]
      }
